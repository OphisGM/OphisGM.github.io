<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Mercado del Rol - Admin Tienda</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            background: linear-gradient(135deg, #1e1b2e 0%, #2a2438 100%);
            min-height: 100vh;
            padding: 20px;
            color: #f0e6ff;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        /* Encabezado */
        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 2.5rem;
            background: linear-gradient(135deg, #ffd89b, #c7e9fb);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }

        .header p {
            color: #b9b0d4;
            margin-top: 8px;
        }

        /* Panel Admin (formulario) */
        .admin-panel {
            background: rgba(30, 27, 46, 0.8);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 24px;
            margin-bottom: 30px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        .admin-panel h2 {
            font-size: 1.5rem;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
            color: #c4b5fd;
        }

        input, textarea {
            width: 100%;
            padding: 12px 14px;
            background: #1a1829;
            border: 1px solid #3d3654;
            border-radius: 16px;
            font-size: 1rem;
            color: #f0e6ff;
            font-family: inherit;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: #8b5cf6;
            box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.3);
        }

        textarea {
            resize: vertical;
            min-height: 70px;
        }

        .btn {
            background: #8b5cf6;
            border: none;
            padding: 12px 24px;
            border-radius: 40px;
            font-weight: bold;
            font-size: 1rem;
            color: white;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-right: 10px;
            margin-top: 8px;
        }

        .btn-danger {
            background: #dc2626;
        }

        .btn-danger:hover {
            background: #b91c1c;
            transform: scale(1.02);
        }

        .btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.05);
        }

        /* Grid de productos */
        .productos-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 24px;
            margin-top: 20px;
        }

        .product-card {
            background: rgba(42, 36, 56, 0.7);
            backdrop-filter: blur(5px);
            border-radius: 24px;
            padding: 20px;
            border: 1px solid rgba(139, 92, 246, 0.3);
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 28px rgba(0,0,0,0.4);
            border-color: #8b5cf6;
        }

        .product-name {
            font-size: 1.5rem;
            font-weight: bold;
            margin-bottom: 8px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-price {
            background: #00000055;
            padding: 4px 12px;
            border-radius: 40px;
            font-size: 0.9rem;
            color: #ffd966;
        }

        .product-desc {
            color: #ccc2e6;
            margin: 12px 0;
            line-height: 1.4;
        }

        .product-footer {
            display: flex;
            justify-content: flex-end;
            margin-top: 16px;
        }

        .btn-eliminar {
            background: #4a1d6d;
            color: #ffb4a2;
            padding: 8px 16px;
            font-size: 0.85rem;
        }

        .empty-message {
            text-align: center;
            padding: 50px;
            background: rgba(0,0,0,0.3);
            border-radius: 32px;
            color: #b9b0d4;
            font-style: italic;
        }

        .stats {
            text-align: right;
            font-size: 0.85rem;
            margin-bottom: 10px;
            color: #b9b0d4;
        }

        @media (max-width: 640px) {
            body { padding: 12px; }
            .product-name { font-size: 1.2rem; }
            .btn { width: 100%; margin-bottom: 8px; }
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>🛒 Mercado del Rol</h1>
        <p>Panel de administración · Moneda: ✨ Urudium</p>
    </div>

    <!-- Panel de admin para crear/retirar artículos -->
    <div class="admin-panel">
        <h2>🔧 ADMIN — Gestionar Tienda</h2>
        <div class="form-group">
            <label>Nombre del artículo</label>
            <input type="text" id="nombreProducto" placeholder="Ej: Poción de Fuego eterno">
        </div>
        <div class="form-group">
            <label>💰 Precio (Urudium)</label>
            <input type="number" id="precioProducto" placeholder="50">
        </div>
        <div class="form-group">
            <label>📝 Descripción</label>
            <textarea id="descripcionProducto" placeholder="Describe el objeto de rol..."></textarea>
        </div>
        <button class="btn" id="btnAgregar">➕ Agregar artículo</button>
        <button class="btn btn-danger" id="btnEliminarUltimo">🗑️ Retirar último artículo</button>
        <button class="btn" id="btnLimpiarTodo" style="background:#6c5b8a;">⚠️ Eliminar toda la tienda</button>
    </div>

    <div class="stats" id="contadorStats">📦 Cargando productos...</div>
    <div id="productosContainer" class="productos-grid">
        <!-- acá se renderizan los productos -->
    </div>
</div>

<script>
    // ---------- Clave para guardar en localStorage ----------
    const STORAGE_KEY = "tienda_rol_urudium";

    // ---------- Productos iniciales (genéricos de ejemplo) ----------
    const productosIniciales = [
        {
            id: "item_1",
            nombre: "💎 Gema de Sombra",
            precio: 45,
            descripcion: "Brilla en la oscuridad, otorga +2 sigilo en partidas nocturnas."
        },
        {
            id: "item_2",
            nombre: "⚔️ Colmillo de Wyvern",
            precio: 120,
            descripcion: "Arma afilada que corta armaduras básicas. Ideal para cazadores."
        },
        {
            id: "item_3",
            nombre: "🧪 Elixir de Urudium",
            precio: 30,
            descripcion: "Recupera 1d6 de energía mágica. Sabor a frutos del vacío."
        },
        {
            id: "item_4",
            nombre: "🛡️ Escudo Etéreo",
            precio: 85,
            descripcion: "Bloquea un ataque por encuentro. Resistencia fantasmal."
        }
    ];

    // ----- Cargar o inicializar productos -----
    let productos = [];

    function cargarProductos() {
        const guardados = localStorage.getItem(STORAGE_KEY);
        if (guardados) {
            productos = JSON.parse(guardados);
        } else {
            // primera vez: usar los iniciales y guardar
            productos = [...productosIniciales];
            guardarProductos();
        }
        renderizarTienda();
    }

    function guardarProductos() {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(productos));
    }

    // ----- Agregar nuevo artículo (con ID único)-----
    function agregarProducto(nombre, precio, descripcion) {
        if (!nombre.trim()) {
            alert("❌ Escribe un nombre para el artículo");
            return false;
        }
        if (isNaN(precio) || precio <= 0) {
            alert("❌ Precio inválido. Debe ser un número mayor a 0");
            return false;
        }
        const nuevoId = Date.now() + "-" + Math.random().toString(36).substr(2, 6);
        const nuevo = {
            id: nuevoId,
            nombre: nombre.trim(),
            precio: Number(precio),
            descripcion: descripcion.trim() || "Sin descripción"
        };
        productos.push(nuevo);
        guardarProductos();
        renderizarTienda();
        return true;
    }

    // ----- Eliminar producto por ID (para usar desde el botón eliminar en cada carta)-----
    function eliminarProductoPorId(id) {
        productos = productos.filter(p => p.id !== id);
        guardarProductos();
        renderizarTienda();
    }

    // ----- Retirar el último artículo (por orden de creación) -----
    function retirarUltimoArticulo() {
        if (productos.length === 0) {
            alert("⚠️ No hay artículos para retirar.");
            return;
        }
        const eliminado = productos.pop();
        guardarProductos();
        renderizarTienda();
        alert(`🗑️ Se retiró: "${eliminado.nombre}" de la tienda.`);
    }

    // ----- Eliminar TODOS los artículos -----
    function limpiarTiendaCompleta() {
        if (confirm("⚠️ ¿SEGURO? Vas a eliminar TODOS los artículos de la tienda. No se puede deshacer.")) {
            productos = [];
            guardarProductos();
            renderizarTienda();
            alert("🏚️ Tienda vaciada por completo.");
        }
    }

    // ----- Renderizar la tienda (solo lectura para mostrar artículos)-----
    function renderizarTienda() {
        const container = document.getElementById("productosContainer");
        const statsDiv = document.getElementById("contadorStats");

        if (!productos.length) {
            container.innerHTML = `<div class="empty-message">✨ No hay artículos publicados. Usa el panel admin para agregar.<br>🎭 Los jugadores verán esto vacío hasta que publiques algo.</div>`;
            statsDiv.innerHTML = `📦 0 artículos en tienda | Admin puede agregar ↓`;
            return;
        }

        // Mostrar contador
        statsDiv.innerHTML = `📦 ${productos.length} artículos disponibles | ✨ Moneda: Urudium`;

        // Generar HTML para cada producto (sin opción de compra, solo catálogo)
        let html = "";
        for (let prod of productos) {
            html += `
                <div class="product-card" data-id="${prod.id}">
                    <div class="product-name">
                        ${escapeHtml(prod.nombre)}
                        <span class="product-price">✨ ${prod.precio} Urudium</span>
                    </div>
                    <div class="product-desc">${escapeHtml(prod.descripcion)}</div>
                    <div class="product-footer">
                        <button class="btn-eliminar btn" data-id="${prod.id}">🗑️ Retirar</button>
                    </div>
                </div>
            `;
        }
        container.innerHTML = html;

        // Asignar eventos a todos los botones "Retirar" de cada carta
        document.querySelectorAll('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                if (confirm("¿Retirar este artículo de la tienda? Los jugadores ya no lo verán.")) {
                    eliminarProductoPorId(id);
                }
            });
        });
    }

    // Pequeña ayuda para evitar XSS y caracteres raros
    function escapeHtml(str) {
        return str
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // ----- Eventos y lógica al cargar la página -----
    document.addEventListener('DOMContentLoaded', () => {
        cargarProductos();

        const btnAgregar = document.getElementById("btnAgregar");
        const btnEliminarUltimo = document.getElementById("btnEliminarUltimo");
        const btnLimpiarTodo = document.getElementById("btnLimpiarTodo");

        btnAgregar.addEventListener('click', () => {
            const nombre = document.getElementById("nombreProducto").value;
            const precio = document.getElementById("precioProducto").value;
            const descripcion = document.getElementById("descripcionProducto").value;
            if (agregarProducto(nombre, precio, descripcion)) {
                // limpiar formulario después de agregar
                document.getElementById("nombreProducto").value = "";
                document.getElementById("precioProducto").value = "";
                document.getElementById("descripcionProducto").value = "";
            }
        });

        btnEliminarUltimo.addEventListener('click', () => {
            retirarUltimoArticulo();
        });

        btnLimpiarTodo.addEventListener('click', () => {
            limpiarTiendaCompleta();
        });
    });
</script>
</body>
</html>
